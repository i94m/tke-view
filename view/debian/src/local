            TEST_FILE="$test_file" METHODS_CSV="$methods_csv" php -r '
$preflight = json_decode(getenv("PREFLIGHT_JSON"), true);
if (!is_array($preflight)) {
    $preflight = ["status" => "blocked", "message" => getenv("PREFLIGHT_JSON")];
}
$methods = array_values(array_filter(array_map("trim", explode(",", getenv("METHODS_CSV") ?: ""))));
$hint = is_array($preflight) && isset($preflight["hint"]) ? (string) $preflight["hint"] : "Run: bin/local diagnose";
$blockers = is_array($preflight) && isset($preflight["blockers"]) ? $preflight["blockers"] : [];
$summary = $blockers !== [] ? "Preflight blocked: " . implode(", ", $blockers) : "Preflight blocked";
echo json_encode([
    "phase" => getenv("PHASE"),
    "site" => getenv("SITE"),
    "lane" => getenv("LANE"),
    "resolvedLane" => getenv("LANE"),
    "resolvedProfile" => getenv("PROFILE"),
    "testFile" => getenv("TEST_FILE"),
    "targetedMethods" => $methods,
    "testMethods" => $methods,
    "resolvedPhpunitPath" => "",
    "commandUsed" => "none",
    "rawExitCode" => 3,
    "resultType" => "environment_blocked",
    "verdict" => "environment_blocked",
    "failureCategory" => "environment_blocked",
    "assertionSummary" => "none",
    "environmentSummary" => $summary,
    "assertionEvidence" => "none",
    "nonAssertionEvidence" => $summary,
    "missingMethods" => [],
    "methodResults" => [],
    "preflightResult" => $preflight,
    "next" => "diagnose",
], JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE) . PHP_EOL;
'
        return 0
    fi

    cat <<EOF
phase: ${phase}
site: ${site}
lane: ${lane}
resolved_profile: ${profile}
test_file: ${test_file}
result_type: environment_blocked
failure_category: environment_blocked
environment_summary: preflight blocked
next: diagnose
EOF
}

run_container_tdd_preflight() {
    local site="$1"
    local test_file="$2"
    local preflight_script=""
    local preflight_output=""
    local preflight_lines=()
    local preflight_status=""
    local status_field=""

    PREFLIGHT_RESOLVED_PHPUNIT_PATH=""
    PREFLIGHT_EXEC_WORKDIR=""
    PREFLIGHT_EXEC_CONFIG=""
    PREFLIGHT_EXEC_TEST_PATH=""
    PREFLIGHT_EXEC_PREPEND=""
    PREFLIGHT_OUTPUT=""

    preflight_script="$(resolve_runtime_script_path preflight-tdd.php)"
    export_tdd_preflight_env "$site" "$test_file"

    set +e
    preflight_output="$(php "$preflight_script" --site "$site" --test-file "$test_file" --format shell 2>&1)"
    preflight_status=$?
    set -e

    while IFS= read -r line; do
        preflight_lines+=("$line")
    done <<EOF
$preflight_output
EOF

    status_field="${preflight_lines[0]:-}"
    PREFLIGHT_RESOLVED_PHPUNIT_PATH="${preflight_lines[5]:-}"
    PREFLIGHT_EXEC_WORKDIR="${preflight_lines[6]:-}"
    PREFLIGHT_EXEC_CONFIG="${preflight_lines[7]:-}"
    PREFLIGHT_EXEC_TEST_PATH="${preflight_lines[8]:-}"
    PREFLIGHT_EXEC_PREPEND="${preflight_lines[9]:-}"
    PREFLIGHT_OUTPUT="${preflight_lines[13]:-$preflight_output}"

    if [[ $preflight_status -ne 0 || "$status_field" != "ready" ]]; then
        return 2
    fi

    return 0
}

run_preflight_tdd_command() {
    local test_file=""
    local lane=""
    local methods_csv=""
    local preflight_script=""
    local preflight_output=""
    local preflight_rc=0

    parse_local_options "preflight-tdd" "$@"
    test_file="$PARSE_test_file"
    lane="$PARSE_lane"

    [[ -n "$test_file" ]] || fail "preflight-tdd requires --file <path>"

    resolve_context
    RUNTIME_MODE="preflight_tdd"

