prepare_runtime_stat_mtime() {
    local path="$1"

    if stat -c %Y "$path" >/dev/null 2>&1; then
        stat -c %Y "$path"
        return 0
    fi

    if stat -f %m "$path" >/dev/null 2>&1; then
        stat -f %m "$path"
        return 0
    fi

    printf '0\n'
}

prepare_runtime_path_signature() {
    local path="$1"
    local size="0"

    if [[ -L "$path" ]]; then
        printf 'link|%s|%s|%s\n' "$path" "$(prepare_runtime_stat_mtime "$path")" "$(readlink "$path" 2>/dev/null || true)"
        return 0
    fi

    if [[ -f "$path" ]]; then
        size="$(wc -c < "$path" 2>/dev/null | tr -d '[:space:]')"
        printf 'file|%s|%s|%s\n' "$path" "$(prepare_runtime_stat_mtime "$path")" "${size:-0}"
        return 0
    fi

    if [[ -d "$path" ]]; then
        printf 'dir|%s|%s\n' "$path" "$(prepare_runtime_stat_mtime "$path")"
        return 0
    fi

    printf 'missing|%s\n' "$path"
}

prepare_runtime_cache_key() {
    local autotest_root="${VIEW_AUTOTEST_ROOT:-$DEFAULT_AUTOTEST_ROOT}"

    {
        printf 'site=%s\n' "$SITE"
        printf 'app_root=%s\n' "$APP_ROOT"
        printf 'site_root=%s\n' "$SITE_ROOT"
        printf 'runtime_dir=%s\n' "$DEFAULT_TKE_LOCAL_LIB"
        printf 'tk_path=%s\n' "${VIEW_TK_PATH:-$DEFAULT_TK_ROOT}"
        printf 'legacy_tk_root=%s\n' "${VIEW_LEGACY_TK_ROOT:-/opt/tkdev2}"
        printf 'autotest_root=%s\n' "$autotest_root"
        printf 'autotest_country=%s\n' "${VIEW_AUTOTEST_COUNTRY_NAME:-china}"
        if [[ -d "$autotest_root/phpunit" ]]; then
            printf 'autotest_mounted=1\n'
        else
            printf 'autotest_mounted=0\n'
        fi
    } | cksum | awk '{print $1 "-" $2}'
}

prepare_runtime_fingerprint() {
    local autotest_root="${VIEW_AUTOTEST_ROOT:-$DEFAULT_AUTOTEST_ROOT}"

    {
        printf 'site=%s\n' "$SITE"
        printf 'app_root=%s\n' "$APP_ROOT"
        printf 'site_root=%s\n' "$SITE_ROOT"
        printf 'runtime_dir=%s\n' "$DEFAULT_TKE_LOCAL_LIB"
        printf 'tk_path=%s\n' "${VIEW_TK_PATH:-$DEFAULT_TK_ROOT}"
        printf 'legacy_tk_root=%s\n' "${VIEW_LEGACY_TK_ROOT:-/opt/tkdev2}"
        printf 'autotest_root=%s\n' "$autotest_root"
        printf 'autotest_country=%s\n' "${VIEW_AUTOTEST_COUNTRY_NAME:-china}"
        prepare_runtime_path_signature "$DEFAULT_TKE_LOCAL_LIB/prepare-local-runtime-assets.php"
        prepare_runtime_path_signature "$DEFAULT_TKE_LOCAL_LIB/prepare-autotest-bridges.php"
        prepare_runtime_path_signature "$DEFAULT_TKE_LOCAL_LIB/templates/ViewLoggerConfig.php"
        prepare_runtime_path_signature "$DEFAULT_TKE_LOCAL_LIB/templates/log4php_config.xml"
        prepare_runtime_path_signature "$SITE_ROOT/log4php_config.xml"
        if [[ -d "$autotest_root/phpunit" ]]; then
            printf 'autotest_mounted=1\n'
            prepare_runtime_path_signature "$autotest_root/phpunit"
        else
            printf 'autotest_mounted=0\n'
        fi
    } | cksum | awk '{print $1 "-" $2}'
}

prepare_runtime_cache_file() {
    local cache_dir="${VIEW_LOCAL_PREPARE_CACHE_DIR:-/tmp/view-local-prepare-cache}"

    if ! mkdir -p "$cache_dir" 2>/dev/null; then
        printf '\n'
        return 0
    fi

    printf '%s/%s.stamp\n' "$cache_dir" "$(prepare_runtime_cache_key)"
}

prepare_runtime_symlink_matches() {
    local link_path="$1"
    local expected_target="$2"
    local current_target=""

    [[ -L "$link_path" ]] || return 1
    current_target="$(readlink "$link_path" 2>/dev/null || true)"
    [[ "$current_target" == "$expected_target" ]]
}

prepare_runtime_outputs_ready() {
    local autotest_root="${VIEW_AUTOTEST_ROOT:-$DEFAULT_AUTOTEST_ROOT}"
    local tk_path="${VIEW_TK_PATH:-$DEFAULT_TK_ROOT}"
    local legacy_root="${VIEW_LEGACY_TK_ROOT:-/opt/tkdev2}"
    local country="${VIEW_AUTOTEST_COUNTRY_NAME:-china}"

    [[ -f "$APP_ROOT/ViewLoggerConfig.php" ]] || return 1
    [[ -f "$APP_ROOT/log4php_config.xml" ]] || return 1

    if [[ -d "$autotest_root/phpunit" ]]; then
        prepare_runtime_symlink_matches "$legacy_root/$country/web" "$APP_ROOT/web" || return 1
        prepare_runtime_symlink_matches "$tk_path/autotest" "$autotest_root" || return 1

        if [[ -d "$APP_ROOT/web" ]]; then
            prepare_runtime_symlink_matches "$tk_path/web" "$APP_ROOT/web" || return 1
        fi
        if [[ -d "$APP_ROOT/sys" ]]; then
            prepare_runtime_symlink_matches "$tk_path/sys" "$APP_ROOT/sys" || return 1
        fi
        if [[ -d "$APP_ROOT/vivid" ]]; then
            prepare_runtime_symlink_matches "$tk_path/vivid" "$APP_ROOT/vivid" || return 1
        fi
    fi

    return 0
}

prepare_runtime() {
    local autotest_root="${VIEW_AUTOTEST_ROOT:-$DEFAULT_AUTOTEST_ROOT}"
    local cache_file=""
    local current_fingerprint=""
    local cached_fingerprint=""

    ensure_site_bridge
    export_runtime_env

    if [[ "${VIEW_LOCAL_DISABLE_PREPARE_CACHE:-0}" != "1" ]]; then
        cache_file="$(prepare_runtime_cache_file)"
        current_fingerprint="$(prepare_runtime_fingerprint)"

        if [[ -n "$cache_file" && -f "$cache_file" ]]; then
            cached_fingerprint="$(cat "$cache_file" 2>/dev/null || true)"
            if [[ "$cached_fingerprint" == "$current_fingerprint" ]] && prepare_runtime_outputs_ready; then
                return 0
            fi
        fi
    fi

    php "$DEFAULT_TKE_LOCAL_LIB/prepare-local-runtime-assets.php" >/dev/null \
        || fail "failed to prepare local runtime assets (ViewLoggerConfig / log4php)"
    if [[ -d "$autotest_root/phpunit" ]]; then
        php "$DEFAULT_TKE_LOCAL_LIB/prepare-autotest-bridges.php" >/dev/null \
            || fail "failed to prepare autotest legacy path bridges"
    fi

    if [[ -n "$cache_file" && -n "$current_fingerprint" ]]; then
        printf '%s\n' "$current_fingerprint" > "$cache_file"
    fi
}

resolve_phpunit_entrypoint() {
    local resolved_path=""

    resolved_path="$(php -d "auto_prepend_file=$PHP_BOOTSTRAP" "$PHPUNIT_BOOTSTRAP_HELPER" --print-phpunit-bin)"
    [[ -n "$resolved_path" ]] || fail "PHPUnit bootstrap helper returned an empty path: $PHPUNIT_BOOTSTRAP_HELPER"
    [[ -f "$resolved_path" ]] || fail "PHPUnit entrypoint not found: $resolved_path"

    PHPUNIT="$resolved_path"
}

reuse_preflight_phpunit_entrypoint_or_resolve() {
    if [[ -n "$PREFLIGHT_RESOLVED_PHPUNIT_PATH" ]]; then
        [[ -f "$PREFLIGHT_RESOLVED_PHPUNIT_PATH" ]] \
            || fail "PHPUnit entrypoint from preflight not found: $PREFLIGHT_RESOLVED_PHPUNIT_PATH"
        PHPUNIT="$PREFLIGHT_RESOLVED_PHPUNIT_PATH"
        return 0
    fi

    resolve_phpunit_entrypoint
}

reuse_preflight_execution_contract_or_configure() {
    local profile="$1"
    local test_file="$2"

    if [[ -n "$PREFLIGHT_EXEC_WORKDIR" && -n "$PREFLIGHT_EXEC_CONFIG" && -n "$PREFLIGHT_EXEC_TEST_PATH" && -n "$PREFLIGHT_EXEC_PREPEND" ]]; then
        [[ -d "$PREFLIGHT_EXEC_WORKDIR" ]] || fail "PHPUnit workdir from preflight not found: $PREFLIGHT_EXEC_WORKDIR"
        [[ -f "$PREFLIGHT_EXEC_CONFIG" ]] || fail "PHPUnit config from preflight not found: $PREFLIGHT_EXEC_CONFIG"
        [[ -f "$PREFLIGHT_EXEC_PREPEND" ]] || fail "PHP bootstrap from preflight not found: $PREFLIGHT_EXEC_PREPEND"

        PHPUNIT_EXEC_WORKDIR="$PREFLIGHT_EXEC_WORKDIR"
        PHPUNIT_EXEC_CONFIG="$PREFLIGHT_EXEC_CONFIG"
        PHPUNIT_EXEC_TEST_PATH="$PREFLIGHT_EXEC_TEST_PATH"
        PHPUNIT_EXEC_PREPEND="$PREFLIGHT_EXEC_PREPEND"
        return 0
    fi

    configure_phpunit_execution_for_profile "$profile" "$test_file"
}

run_diagnose() {
    parse_local_options "diagnose" "$@"
    [[ ${#REMAINING_ARGS[@]} -eq 0 ]] || fail "diagnose does not accept positional arguments"

    resolve_context
    RUNTIME_MODE="diagnose"
    run_runtime_inspector

    case "$OUTPUT_FORMAT" in
        json)
            print_diagnose_json
            ;;
        text)
            print_diagnose_text
            ;;
        *)
            fail "unsupported --format '$OUTPUT_FORMAT'; expected json or text"
            ;;
    esac
}

run_php() {
    local command_name=""

    parse_local_options "run" "$@"
    resolve_context
    RUNTIME_MODE="run"

    [[ ${#REMAINING_ARGS[@]} -gt 0 ]] || fail "run requires a command after --"

    prepare_runtime
    command_name="$(basename "${REMAINING_ARGS[0]}")"

    if [[ "$command_name" == php* ]]; then
        exec "${REMAINING_ARGS[0]}" -d "auto_prepend_file=$PHP_BOOTSTRAP" "${REMAINING_ARGS[@]:1}"
    fi

    exec "${REMAINING_ARGS[@]}"
}

run_artisan() {
    parse_local_options "artisan" "$@"
    resolve_context
    RUNTIME_MODE="artisan"

    [[ ${#REMAINING_ARGS[@]} -gt 0 ]] || fail "artisan requires arguments after --"

    prepare_runtime
    cd "$APP_ROOT/vivid"
    exec php -d "auto_prepend_file=$PHP_BOOTSTRAP" "$LARAVEL_ARTISAN" "${REMAINING_ARGS[@]}"
}

emit_tdd_lane_blocked() {
    local phase="$1"
    local site="$2"
    local lane="$3"
    local test_file="$4"
    local profile="$5"
    local message="$6"
    local format="$7"
    local methods_csv="${8:-}"

    if [[ "$format" == "json" ]]; then
        php -r '
$phase = $argv[1];
$site = $argv[2];
$lane = $argv[3];
$testFile = $argv[4];
$profile = $argv[5];
$message = $argv[6];
$methods = array_values(array_filter(array_map("trim", explode(",", $argv[7] ?? ""))));
echo json_encode([
    "phase" => $phase,
    "site" => $site,
    "lane" => $lane,
    "resolvedLane" => $lane,
    "resolvedProfile" => $profile,
    "testFile" => $testFile,
    "targetedMethods" => $methods,
    "resolvedPhpunitPath" => "",
    "commandUsed" => "none",
    "rawExitCode" => 3,
    "resultType" => "environment_blocked",
    "verdict" => "environment_blocked",
    "failureCategory" => "environment_blocked",
    "assertionSummary" => "none",
    "environmentSummary" => $message,
    "assertionEvidence" => "none",
    "nonAssertionEvidence" => $message,
    "missingMethods" => [],
    "methodResults" => [],
    "next" => "fix_environment",
], JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE) . PHP_EOL;
' "$phase" "$site" "$lane" "$test_file" "$profile" "$message" "$methods_csv"
        return 0
    fi

    cat <<EOF
phase: ${phase}
site: ${site}
lane: ${lane}
resolved_profile: ${profile}
