run_test() {
    local unit_target=""
    local filter_name=""
    local passthrough=()
    local phpunit_args=()

    parse_local_options "test" "$@"
    unit_target="$PARSE_unit_target"
    filter_name="$PARSE_filter_name"
    if [[ ${#REMAINING_ARGS[@]} -gt 0 ]]; then
        passthrough=("${REMAINING_ARGS[@]}")
    fi

    resolve_context
    RUNTIME_MODE="test"

    if [[ -z "$unit_target" && -z "$filter_name" ]]; then
        fail "test requires at least one of --unit or --filter"
    fi

    if [[ -z "$unit_target" ]]; then
        unit_target="$DEFAULT_UNIT_TARGET"
    fi

    if [[ -n "$filter_name" ]]; then
        phpunit_args+=(--filter "$filter_name")
    fi
    phpunit_args+=("$unit_target")
    if [[ ${#passthrough[@]} -gt 0 ]]; then
        phpunit_args+=("${passthrough[@]}")
    fi

    local resolved_test_file="$unit_target"
    local resolved_profile="vivid-unit"

    if [[ "$unit_target" == autotest/phpunit/* ]]; then
        if ! resolve_tdd_lane_or_block "GREEN" "$SITE" "$unit_target" "" "text" ""; then
            exit 3
        fi
        resolved_test_file="$RESOLVED_TDD_TEST_FILE"
        resolved_profile="$RESOLVED_TDD_PROFILE"
    fi

    prepare_runtime
    configure_phpunit_execution_for_profile "$resolved_profile" "$resolved_test_file"
    resolve_phpunit_entrypoint

    if [[ "$resolved_profile" == "sharp-unit" ]]; then
        phpunit_args=()
        if [[ -n "$filter_name" ]]; then
            phpunit_args+=(--filter "$filter_name")
        fi
        phpunit_args+=(--configuration "$PHPUNIT_EXEC_CONFIG")
        phpunit_args+=("$PHPUNIT_EXEC_TEST_PATH")
        if [[ ${#passthrough[@]} -gt 0 ]]; then
            phpunit_args+=("${passthrough[@]}")
        fi
        cd "$PHPUNIT_EXEC_WORKDIR"
        exec php -d "auto_prepend_file=$PHPUNIT_EXEC_PREPEND" "$PHPUNIT" "${phpunit_args[@]}"
    fi

    cd "$PHPUNIT_EXEC_WORKDIR"
    exec php -d "auto_prepend_file=$PHPUNIT_EXEC_PREPEND" "$PHPUNIT" "${phpunit_args[@]}"
}

run_tdd() {
    local phase=""
    local test_file=""
    local methods_csv=""
    local lane=""
    local skip_preflight=false
    local passthrough=()
    local phpunit_args=()
    local junit_file=""
    local stdout_file=""
    local stderr_file=""
    local filter_pattern=""
    local raw_status=0
    local command_used=""
    local parser_status=0
    local parser_output=""
    local parser_format="$DEFAULT_TDD_OUTPUT_FORMAT"

    PREFLIGHT_RESOLVED_PHPUNIT_PATH=""
    PREFLIGHT_EXEC_WORKDIR=""
    PREFLIGHT_EXEC_CONFIG=""
    PREFLIGHT_EXEC_TEST_PATH=""
    PREFLIGHT_EXEC_PREPEND=""

    parse_local_options "tdd-run" "$@"
    phase="$PARSE_phase"
    test_file="$PARSE_test_file"
    methods_csv="$PARSE_methods_csv"
    lane="$PARSE_lane"
    if [[ "$PARSE_skip_preflight" == true ]]; then
        skip_preflight=true
    fi
    parser_format="$OUTPUT_FORMAT"
    if [[ -n "$PARSE_parser_json" ]]; then
        parser_format="$PARSE_parser_json"
    fi
    if [[ ${#REMAINING_ARGS[@]} -gt 0 ]]; then
        passthrough=("${REMAINING_ARGS[@]}")
    fi

    phase="$(printf '%s' "$phase" | tr '[:lower:]' '[:upper:]')"
    [[ "$phase" == "RED" || "$phase" == "GREEN" ]] || fail "unsupported --phase '$phase'; expected RED or GREEN"
    [[ -n "$test_file" ]] || fail "tdd-run requires --file <path>"
    [[ "$parser_format" == "json" || "$parser_format" == "text" ]] || fail "unsupported --format '$parser_format'; expected json or text"

    resolve_context
    RUNTIME_MODE="tdd_run"

    if ! resolve_tdd_lane_or_block "$phase" "$SITE" "$test_file" "$lane" "$parser_format" "$methods_csv"; then
        return 3
    fi

    lane="$RESOLVED_TDD_LANE"
    test_file="$RESOLVED_TDD_TEST_FILE"

    prepare_runtime

    if [[ "$skip_preflight" != true && "${VIEW_LOCAL_SKIP_PREFLIGHT:-}" != "1" ]]; then
        set +e
        run_container_tdd_preflight "$SITE" "$test_file"
        local preflight_rc=$?
        set -e
        if [[ $preflight_rc -ne 0 ]]; then
            emit_tdd_preflight_blocked \
                "$phase" \
                "$SITE" \
                "$lane" \
                "$RESOLVED_TDD_PROFILE" \
                "$test_file" \
                "$methods_csv" \
                "$PREFLIGHT_OUTPUT" \
                "$parser_format"
            return 3
        fi
    fi

    reuse_preflight_execution_contract_or_configure "$RESOLVED_TDD_PROFILE" "$test_file"
    reuse_preflight_phpunit_entrypoint_or_resolve
    [[ -f "$DEFAULT_TDD_RESULT_PARSER" ]] || fail "TDD result parser not found: $DEFAULT_TDD_RESULT_PARSER"

    if [[ -n "$methods_csv" ]]; then
        filter_pattern="$(build_exact_methods_filter "$methods_csv")"
    fi

    junit_file="$(mktemp /tmp/view-local-junit.XXXXXX)"
    stdout_file="$(mktemp /tmp/view-local-tdd-stdout.XXXXXX)"
    stderr_file="$(mktemp /tmp/view-local-tdd-stderr.XXXXXX)"

    phpunit_args+=(--configuration "$PHPUNIT_EXEC_CONFIG")
    phpunit_args+=(--log-junit "$junit_file")
    if [[ -n "$filter_pattern" ]]; then
        phpunit_args+=(--filter "$filter_pattern")
    fi
    phpunit_args+=("$PHPUNIT_EXEC_TEST_PATH")
    if [[ ${#passthrough[@]} -gt 0 ]]; then
        phpunit_args+=("${passthrough[@]}")
    fi

    command_used="$(join_command_for_display php -d "auto_prepend_file=$PHPUNIT_EXEC_PREPEND" "$PHPUNIT" "${phpunit_args[@]}")"

    cd "$PHPUNIT_EXEC_WORKDIR"
    set +e
    php -d "auto_prepend_file=$PHPUNIT_EXEC_PREPEND" "$PHPUNIT" "${phpunit_args[@]}" >"$stdout_file" 2>"$stderr_file"
    raw_status=$?
    set -e

    set +e
    parser_output="$(
        php "$DEFAULT_TDD_RESULT_PARSER" \
            --format "$parser_format" \
            --phase "$phase" \
            --site "$SITE" \
            --lane "$lane" \
            --test-file "$test_file" \
            --methods "$methods_csv" \
            --resolved-profile "$RESOLVED_TDD_PROFILE" \
            --resolved-phpunit-path "$PHPUNIT" \
            --command-used "$command_used" \
            --raw-exit-code "$raw_status" \
            --junit "$junit_file" \
            --stdout-file "$stdout_file" \
            --stderr-file "$stderr_file"
    )"
    parser_status=$?
    set -e

    rm -f "$junit_file" "$stdout_file" "$stderr_file"

    printf '%s\n' "$parser_output"
    return "$parser_status"
}

main() {
    [[ $# -gt 0 ]] || {
        usage
        exit 1
    }

    case "$1" in
        prepare-sites)
            shift
            run_prepare_sites "$@"
            ;;
        diagnose)
            shift
            run_diagnose "$@"
            ;;
        inspect-contract)
            shift
            run_inspect_contract "$@"
            ;;
        preflight-tdd)
            shift
            run_preflight_tdd_command "$@"
            ;;
        run)
            shift
            run_php "$@"
            ;;
        artisan)
            shift
            run_artisan "$@"
            ;;
        test)
            shift
            run_test "$@"
            ;;
        tdd-run)
            shift
            run_tdd "$@"
            ;;
        -h|--help)
            usage
            ;;
        *)
            fail "unknown command: $1"
            ;;
    esac
}

main "$@"
