resolve_runtime_script_path() {
    local script_name="$1"
    local image_path="${DEFAULT_TKE_LOCAL_LIB}/${script_name}"

    if [[ -n "$DEFAULT_TDD_LANE_RESOLVER" && "$script_name" == "resolve-tdd-lane.php" ]]; then
        printf '%s\n' "$DEFAULT_TDD_LANE_RESOLVER"
        return 0
    fi
    if [[ -n "$DEFAULT_TDD_CONTRACT_INSPECTOR" && "$script_name" == "inspect-tdd-contract.php" ]]; then
        printf '%s\n' "$DEFAULT_TDD_CONTRACT_INSPECTOR"
        return 0
    fi
    if [[ -f "$image_path" ]]; then
        printf '%s\n' "$image_path"
        return 0
    fi

    fail "runtime script not found: ${image_path} (rebuild image from tke-view/view/debian/src/local-runtime/)"
}

resolve_tdd_lane_or_block() {
    local phase="$1"
    local site="$2"
    local test_file="$3"
    local requested_lane="$4"
    local output_format="$5"
    local methods_csv="${6:-}"
    local resolve_output=""
    local resolve_lines=()
    local resolve_status=0
    local resolve_status_field=""
    local resolved_lane=""
    local resolved_profile=""
    local resolve_message=""
    local normalized_test_file=""
    local lane_resolver=""

    lane_resolver="$(resolve_runtime_script_path resolve-tdd-lane.php)"
    [[ -f "$APP_ROOT/testing-contracts.json" ]] || fail "testing contracts not found: $APP_ROOT/testing-contracts.json"

    set +e
    resolve_output="$(php "$lane_resolver" \
        --contracts "$APP_ROOT/testing-contracts.json" \
        --test-file "$test_file" \
        --lane "$requested_lane" \
        --format shell 2>&1)"
    resolve_status=$?
    set -e

    while IFS= read -r line; do
        resolve_lines+=("$line")
    done <<EOF
$resolve_output
EOF

    resolve_status_field="${resolve_lines[0]:-}"
    resolved_lane="${resolve_lines[1]:-}"
    resolved_profile="${resolve_lines[2]:-}"
    resolve_message="${resolve_lines[3]:-}"
    normalized_test_file="${resolve_lines[4]:-}"

    if [[ $resolve_status -ne 0 || "$resolve_status_field" != "ok" ]]; then
        emit_tdd_lane_blocked \
            "$phase" \
            "$site" \
            "${resolved_lane:-unknown}" \
            "${normalized_test_file:-$test_file}" \
            "${resolved_profile:-unknown}" \
            "${resolve_message:-$resolve_output}" \
            "$output_format" \
            "$methods_csv"
        return 3
    fi

    RESOLVED_TDD_LANE="$resolved_lane"
    RESOLVED_TDD_PROFILE="$resolved_profile"
    RESOLVED_TDD_TEST_FILE="$normalized_test_file"
    return 0
}

